<UserControl x:Class="KeySonic.UI.Views.MouseClickSoundsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,12,24,20">
        <StackPanel>
            <Grid Margin="2,0,2,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MOUSE CLICKS" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="Choose a sound and level for each physical mouse button."
                               Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleButton x:Name="MouseSoundsToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center" Checked="MouseSoundsToggle_Changed"
                              Unchecked="MouseSoundsToggle_Changed"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="PHYSICAL MOUSE" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="MouseActivityText" Text="Click either button to see it light up"
                                   Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Grid Width="172" Height="244" HorizontalAlignment="Center">
                            <Border Width="156" Height="232" CornerRadius="78"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="2">
                                <Grid Margin="7">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="94"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="LeftMouseButtonRegion" CornerRadius="66,6,0,0"
                                                Background="{StaticResource SurfaceBrush}" Margin="1,1,2,1"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            <TextBlock Text="L" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="RightMouseButtonRegion" Grid.Column="1" CornerRadius="6,66,0,0"
                                                Background="{StaticResource SurfaceBrush}" Margin="2,1,1,1"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            <TextBlock Text="R" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="1" Height="76" Background="{StaticResource BorderBrush2}"
                                                HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                        <Border Width="12" Height="30" CornerRadius="6"
                                                Background="{StaticResource BorderBrush2}" BorderBrush="{StaticResource TextMutedBrush}"
                                                BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="0,9,0,0">
                                            <Border x:Name="MouseWheelIndicator" Height="9" Width="2" CornerRadius="1"
                                                    Background="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                        </Border>
                                    </Grid>
                                    <Border Grid.Row="1" Margin="2,0,2,2" CornerRadius="0,0,68,68"
                                            Background="{StaticResource SurfaceBrush}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <TextBlock Text="Physical clicks are detected system-wide while Clackr is running."
                                   Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="LEFT CLICK" FontSize="13" FontWeight="SemiBold"/>
                                <Button Content="Preview" Grid.Column="1" Style="{StaticResource GhostButton}"
                                        Click="PreviewLeft_Click"/>
                            </Grid>
                            <TextBlock Text="SOUND FILE" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="LeftSoundCombo" DisplayMemberPath="DisplayName"
                                      SelectionChanged="LeftSoundCombo_SelectionChanged" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="VOLUME" Style="{StaticResource SectionLabel}" Margin="0"/>
                                <TextBlock x:Name="LeftVolumeText" Text="70%" Style="{StaticResource SubText}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="LeftVolumeSlider" Minimum="0" Maximum="100" Value="70"
                                    ValueChanged="LeftVolumeSlider_ValueChanged"
                                    PreviewMouseLeftButtonUp="VolumeSlider_MouseLeftButtonUp" KeyUp="VolumeSlider_KeyUp"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RIGHT CLICK" FontSize="13" FontWeight="SemiBold"/>
                                <Button Content="Preview" Grid.Column="1" Style="{StaticResource GhostButton}"
                                        Click="PreviewRight_Click"/>
                            </Grid>
                            <TextBlock Text="SOUND FILE" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="RightSoundCombo" DisplayMemberPath="DisplayName"
                                      SelectionChanged="RightSoundCombo_SelectionChanged" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="VOLUME" Style="{StaticResource SectionLabel}" Margin="0"/>
                                <TextBlock x:Name="RightVolumeText" Text="70%" Style="{StaticResource SubText}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="RightVolumeSlider" Minimum="0" Maximum="100" Value="70"
                                    ValueChanged="RightVolumeSlider_ValueChanged"
                                    PreviewMouseLeftButtonUp="VolumeSlider_MouseLeftButtonUp" KeyUp="VolumeSlider_KeyUp"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="MOUSE CLICK LIBRARY" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="LibraryFolderText" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                        <TextBlock Text="Add downloaded audio files here, then refresh the library."
                                   Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="AddFilesButton" Content="Add files" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                Click="AddFiles_Click"/>
                        <Button x:Name="RefreshLibraryButton" Content="Refresh" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="RefreshLibrary_Click"/>
                        <Button Content="Open folder" Style="{StaticResource PrimaryButton}"
                                Click="OpenLibraryFolder_Click"/>
                    </StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SoundLibraryCountText" Text="0 sounds" Style="{StaticResource SubText}"/>
                    <TextBlock x:Name="SoundLibraryEmptyText" Grid.Row="1"
                               Text="No WAV or MP3 sounds found. Add files to the library to get started."
                               Style="{StaticResource SubText}" Margin="0,10,0,0" Visibility="Collapsed"/>
                            <Grid Grid.Row="2" Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LibrarySearchBox" Height="36" Padding="10,6"
                                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                         TextChanged="LibrarySearchBox_TextChanged" ToolTip="Search mouse sounds"/>
                                <ComboBox x:Name="LibraryFormatFilter" Grid.Column="1" Width="110" Margin="8,0,0,0"
                                          SelectionChanged="LibraryFormatFilter_SelectionChanged" ToolTip="Filter by file format">
                                    <ComboBoxItem Content="All formats" IsSelected="True"/>
                                    <ComboBoxItem Content="WAV"/>
                                    <ComboBoxItem Content="MP3"/>
                                </ComboBox>
                                <Button x:Name="LibrarySortButton" Grid.Column="2" Content="A-Z"
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Click="LibrarySortButton_Click" ToolTip="Sort by file name"/>
                            </Grid>
                                <ItemsControl x:Name="SoundLibraryList" Grid.Row="3" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                            <Border Style="{StaticResource Card}" Width="278" Margin="0,0,10,10">
                                                <StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding RelativePath}" Style="{StaticResource SubText}"
                                                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,10"/>
                                            </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Preview" Style="{StaticResource GhostButton}"
                                                                Margin="0,0,6,0" Padding="9,6" Tag="{Binding}"
                                                                Click="LibraryPreview_Click"/>
                                                        <Button Content="Left" Style="{StaticResource GhostButton}"
                                                                Margin="0,0,6,0" Padding="9,6" Tag="{Binding}"
                                                                Click="LibraryAssignLeft_Click" ToolTip="Use for left click"/>
                                                        <Button Content="Right" Style="{StaticResource GhostButton}"
                                                                Padding="9,6" Tag="{Binding}"
                                                                Click="LibraryAssignRight_Click" ToolTip="Use for right click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
        <Border x:Name="MouseImportBusyOverlay" Background="#CC0E1013" Visibility="Collapsed"
                Panel.ZIndex="10">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="8" Padding="24" Width="340"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,14"/>
                    <TextBlock x:Name="MouseImportBusyStatusText" Text="Adding sounds..."
                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="KeySonic will be ready again shortly."
                               Style="{StaticResource SubText}" Margin="0,5,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>