<UserControl x:Class="KeySonic.UI.Views.SoundLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="KeyboardKeyButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="KeyBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="KeyBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="24,8,24,20">
        <StackPanel>
            <TextBlock Text="SOUND LAB" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ActivePackText" Text="Active pack" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VariationCountText" Style="{StaticResource SubText}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="LAST PREVIEW" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" Margin="0,0,0,3"/>
                            <TextBlock x:Name="SelectedKeyText" Text="-" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="TypingGamePanel" Style="{StaticResource Card}" Margin="0,0,0,14"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="GamePromptText" FontSize="18" FontWeight="SemiBold"
                                       TextWrapping="Wrap" LineHeight="28"/>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="GameProgressBar" Height="5" Minimum="0" Maximum="100"
                                             VerticalAlignment="Center"/>
                                <TextBlock x:Name="GameProgressText" Grid.Column="1" Text="0%"
                                           Style="{StaticResource SubText}" Margin="12,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid x:Name="KeyboardGrid"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,10">
                <Button x:Name="TypingGameButton" Content="Typing game" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left" Click="TypingGameButton_Click"/>
                <Button x:Name="RestartGameButton" Content="Restart" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" Visibility="Collapsed" Click="RestartGameButton_Click"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>