<Window x:Class="KeySonic.UI.Views.PackNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clackr - Name your sound pack" Width="420" Height="210"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}">
    <Border Background="{StaticResource BgBrush}" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Create a sound pack" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Text="Choose a name for this group of sounds."
                       Style="{StaticResource SubText}" Margin="0,5,0,12"/>
            <StackPanel Grid.Row="2">
                <TextBox x:Name="PackNameTextBox" Padding="9,7"/>
                <TextBlock x:Name="ValidationText" Style="{StaticResource SubText}"
                           Foreground="{StaticResource DangerBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Content="Create" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Click="Create_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>