<UserControl x:Class="KeySonic.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="28,8,28,20">
        <StackPanel>

            <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource GroupCard}" Margin="0,0,0,22">
                <StackPanel>

                    <Grid Margin="16,14,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Start with Windows" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock Text="Launch KeySonic automatically when you sign in" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton x:Name="StartWithWindowsToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Checked="StartWithWindowsToggle_Changed" Unchecked="StartWithWindowsToggle_Changed"/>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <Grid Margin="16,14,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Start minimized" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock Text="Open straight to the tray instead of showing the window" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton x:Name="StartMinimizedToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Checked="StartMinimizedToggle_Changed" Unchecked="StartMinimizedToggle_Changed"/>
                    </Grid>

                </StackPanel>
            </Border>

            <TextBlock Text="SOUNDS" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource GroupCard}" Margin="0,0,0,22">
                <Grid Margin="16,14,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Sound packs folder" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock Text="Add a new pack by creating a subfolder here with .wav files" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Click="OpenPacksFolder_Click"/>
                </Grid>
            </Border>

            <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource GroupCard}">
                <StackPanel Margin="16,14,16,14">
                    <TextBlock x:Name="VersionText" Text="KeySonic 1.0.0" FontSize="13.5" FontWeight="SemiBold"/>
                    <TextBlock Text="KeySonic does not record or transmit what you type." Style="{StaticResource SubText}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
