<UserControl x:Class="KeySonic.UI.Views.SoundPackBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,8,24,20">
        <StackPanel>
            <Grid Margin="2,0,2,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="INSTALLED PACKS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                <TextBlock x:Name="PackCountText" Grid.Column="1" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ADD A SOUND PACK" Style="{StaticResource SectionLabel}" Margin="2,0,0,3"/>
                    <TextBlock Text="Import a Mechvibes folder or build a pack from audio files."
                               Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ImportMechvibesButton" Content="Mechvibes folder" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0" Click="ImportMechvibes_Click"/>
                    <Button x:Name="ImportAudioButton" Content="Audio files" Style="{StaticResource PrimaryButton}"
                            Click="ImportAudioFiles_Click"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="SearchBorder" Height="36" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="0" VerticalContentAlignment="Center" Padding="0"
                                     GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                                     LostKeyboardFocus="SearchBox_LostKeyboardFocus"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Search packs" Style="{StaticResource SubText}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </Border>
                <Button x:Name="SortButton" Grid.Column="1" Content="A-Z" Style="{StaticResource GhostButton}"
                        Margin="10,0,0,0" Height="36" Click="SortButton_Click" ToolTip="Sort by pack name"/>
            </Grid>

            <TextBlock x:Name="EmptyStateText" Text="No sound packs match your search." Style="{StaticResource SubText}"
                       Margin="2,12,2,0" Visibility="Collapsed"/>
            <WrapPanel x:Name="CardsPanel"/>
        </StackPanel>
    </ScrollViewer>
        <Border x:Name="ImportBusyOverlay" Background="#CC0E1013" Visibility="Collapsed"
                Panel.ZIndex="10">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="8" Padding="24" Width="340"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,14"/>
                    <TextBlock x:Name="ImportBusyStatusText" Text="Preparing sound pack..."
                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="This may take a moment for larger folders."
                               Style="{StaticResource SubText}" Margin="0,5,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
