<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>KeySonic</AssemblyName>
    <RootNamespace>KeySonic.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeySonic.Core\KeySonic.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\packs\**\*.*" CopyToOutputDirectory="PreserveNewest" LinkBase="packs" />
  </ItemGroup>

</Project>
