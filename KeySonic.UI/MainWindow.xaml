<Window x:Class="KeySonic.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeySonic"
        Height="720" Width="1060"
        MinHeight="650" MinWidth="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SidebarNavigationButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="NavMarker" Width="3" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"
                                    CornerRadius="0,2,2,0" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                <Setter TargetName="NavMarker" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="46" Background="Transparent"
                PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                <TextBlock Text="KeySonic" FontWeight="SemiBold" FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,8,0">
                    <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimize">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource ChromeButton}" Click="MaximizeRestore_Click" ToolTip="Maximize">
                        <TextBlock x:Name="MaximizeRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseChromeButton}" Click="Close_Click" ToolTip="Close to tray">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="184"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,1,0">
                    <StackPanel Margin="12,22,12,12">
                        <TextBlock Text="WORKSPACE" Style="{StaticResource SectionLabel}" Margin="10,0,0,10"/>
                        <Button x:Name="DashboardNavButton" Tag="Active" Style="{StaticResource SidebarNavigationButton}"
                                Click="DashboardNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SoundPacksNavButton" Tag="Inactive" Style="{StaticResource SidebarNavigationButton}"
                                Click="SoundPacksNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Sound packs" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsNavButton" Tag="Inactive" Style="{StaticResource SidebarNavigationButton}"
                                Click="SettingsNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="24,0,18,0">
                        <TextBlock x:Name="PageHeaderText" Text="Dashboard" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="SoundLabButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="38" Height="36" Style="{StaticResource ChromeButton}"
                                Click="SoundLabButton_Click" ToolTip="Sound Lab">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                    </Grid>
                    <ContentControl x:Name="PageHost" Grid.Row="1"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
